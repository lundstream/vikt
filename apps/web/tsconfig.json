{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vite-plugin-app-name.ts",
    "vitest.config.ts"
  ]
}
