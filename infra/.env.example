# Copy to .env at the repo root for development, or to infra/.env for the
# production compose stack, and change every value below.
#
# assertProdSecrets() exits non-zero at boot if SESSION_SECRET or DATABASE_URL
# is missing or still equals the placeholder here. That is deliberate: fail
# closed, never warn and continue (CLAUDE.md §2).

# ---------------------------------------------------------------- the image
# Which build the production stack runs. `IMAGE_TAG` has no default and the
# stack refuses to deploy without it (D148); it is also the one line a rollback
# edits.
#
# `IMAGE_REPO` is where the image comes from. Empty means the registry, which is
# what release.yml publishes to and what a normal deploy pulls. Set it to
# `local/` when the images were built on a workstation and loaded onto the host
# with `docker load`, which is how this installation has deployed before
# (D120, D156).
#
# Neither is read by the API. They are compose-level, like APP_VERSION and
# APP_COMMIT are build-level (D151), which is why the stack-variable guard does
# not look for them.
# IMAGE_TAG=1.1.0
# IMAGE_REPO=local/

# ---------------------------------------------------------------- identity
# Not final. Read at runtime by the API, the page title and the PWA manifest,
# so renaming the app is a restart, never a code edit.
APP_NAME=Vikt

# ---------------------------------------------------------------- secrets
# openssl rand -hex 32
SESSION_SECRET=change-me-to-64-random-hex-characters

# ---------------------------------------------------------------- database
POSTGRES_USER=vikt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vikt
# Development, against the Postgres in infra/docker-compose.dev.yml:
DATABASE_URL=postgres://vikt:change-me@localhost:5432/vikt
# Production, inside the compose network, the host is the service name:
# DATABASE_URL=postgres://vikt:REAL_PASSWORD@postgres:5432/vikt

# ---------------------------------------------------------------- server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# The immediate peer that may speak for a client: an address, a CIDR, or a
# comma-separated list. NOT a hop count — a hop count cannot validate the peer
# and is spoofable by anything that can reach the API directly, so the old
# numeric form is now rejected at boot (DECISIONS.md D14).
#
# Production: the pinned `edge` subnet from infra/docker-compose.yml.
#   TRUST_PROXY=172.31.240.0/24
# Development: nothing is in front of the API, so trust nothing.
TRUST_PROXY=

# The real client address comes from CF-Connecting-IP, which only Cloudflare
# sets, and is read only when the peer above is trusted. That guarantee holds
# only while nginx is restricted to Cloudflare's ranges — see infra/nginx/default.conf.
# Verify by hitting the API from a cellular IP and checking the logged client
# IP is the phone's, not the proxy's (CLAUDE.md §2).

# `Secure` on the session cookie. Keep true anywhere reachable over the
# internet. Set false only for plain HTTP on the LAN during development.
COOKIE_SECURE=false

SESSION_TTL_DAYS=30

# The intake floor no user may set a target below (DECISIONS.md D24). A user's
# own floor can only raise this, never lower it. 1200 kcal is the conventional
# line below which sustained intake is a matter for medical supervision. Move it
# only deliberately.
SYSTEM_INTAKE_FLOOR_KCAL=1200

# --- The optional LLM layer (phase 8) ---------------------------------------
# Empty means off, and off is a supported configuration: nothing in phases 1 to
# 7 depends on this layer, and every feature it adds simply does not appear.
#
# The small model is on the interactive path and is chosen for latency; the
# large one only runs queued work. Both are talked to over Ollama's native
# /api/chat, not /v1/, because /v1/ ignores `think` and these models reason by
# default: 15.0 s against 0.56 s for the same parse. See DECISIONS.md D71.
#
# Do not set num_ctx anywhere: changing it between calls forces a model reload.
# If a larger context is wanted, bake it into a saved model variant and name
# that variant here.
OLLAMA_URL=
OLLAMA_MODEL_SMALL=gemma4:e4b
OLLAMA_MODEL_LARGE=qwen3.6:27b
OLLAMA_TIMEOUT_MS=20000
OLLAMA_JOB_TIMEOUT_MS=180000

# The model that gets sent photographs of food (D143). Empty means the photo
# quick action does not exist, like every other optional mode here.
#
# There is no default and you should not guess one. Ollama reports a `vision`
# capability for models that accept an image and then answer as though nothing
# was attached — gemma4:e4b does exactly that, twice, to a generated picture and
# to a photograph of dinner. A flag describes a build; only a probe describes
# the tag in front of you:
#
#   pnpm --filter api probe:vision --selftest
#
# Set the tag that answers SEES. The API runs the same check at boot and hides
# the surface when it fails, so a wrong value here costs a missing feature
# rather than a broken one.
#
# The photo budget is separate from OLLAMA_TIMEOUT_MS and longer. Measured on
# the development workstation: 0.2 to 1.3 s with the model resident, 5.9 s when
# it has to load first.
LLM_VISION_MODEL=
OLLAMA_VISION_TIMEOUT_MS=60000

# ------------------------------------------------------- development seeding
# `pnpm --filter api seed:dev` creates a shared development account. The
# password lives here rather than in the script, because a literal in the
# source is a published password: anyone who clones the repository knows the
# credentials of an account that exists on every machine that ran the seeder.
#
# There is no default. The seeder refuses without one, and refusing is better
# than inventing a value that ends up being the same on every install.
SEED_EMAIL=test@example.test
SEED_PASSWORD=

# ------------------------------------------------------- secrets at rest
# The key that encrypts secrets the app stores rather than reads: today the
# SMTP password, later a backup destination's credentials. Generate one with
#
#   openssl rand -hex 32
#
# What it buys, exactly: one secret in the environment instead of four, mail
# that can be configured and tested from the admin screens, and a pg_dump that
# does not contain the mail password in clear. What it does not buy: this is
# still a secret in the environment, exactly like SESSION_SECRET, and anyone who
# can read the environment of the running process can decrypt everything it
# protects. It defends a dump at rest and nothing else. See DECISIONS.md D102.
#
# SECRET_KEY_FILE points at a file instead, for Docker secrets. Set one or the
# other, never both: the file wins, and a stale variable beside it decrypts
# nothing while looking configured.
#
# Leave both empty on an install with no mail server and no backup destination.
# Nothing needs a key until something needs storing.
SECRET_KEY=
# SECRET_KEY_FILE=/run/secrets/vikt_secret_key

# ------------------------------------------------------------ outbound mail
# **Mail is configured in the app now**, under Administration, Mejlserver
# (D102). The variables below are read exactly once: on the first boot after
# upgrading past D102 they are imported into the database, the log says so, and
# they should then be removed. They are not read again.
#
# An install with no mail server still boots and works: password reset falls
# back to saying it cannot send, and an approved invite shows its code on screen
# for the admin to pass on by hand.
#
# assertProdSecrets() refuses to start with a placeholder SMTP_PASS, the same
# way it refuses a placeholder SESSION_SECRET: a half-configured mail sender
# that silently fails is worse than one that is off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change-me
SMTP_FROM=Vikt <noreply@example.com>
SMTP_SECURE=false

# Where links in outgoing mail point. Required for mail to be enabled at all,
# because a reset link to nowhere is worse than no reset mail.
# Where this installation is reachable, as an absolute URL (D109). Every link
# in every email is built from it. Without it a link would be relative, which is
# fine in a page and useless in an inbox: no mail client has a base to resolve
# it against, and that is exactly how an invite went out with a dead link in it.
#
# **This is the address recipients will click.** Not the address you reach the
# app at on this machine: a link is opened on somebody else's phone, in their
# mail client, on their network. `https://localhost:5173` is a valid absolute
# URL and is useless to every recipient there has ever been, and it once sat in
# a live instance sending real invites (D113).
#
# assertProdSecrets refuses a value that is not absolute, and in production
# refuses a localhost or private-range address as well. Administration,
# Mejlserver prints the value in use and says so when it is local.
PUBLIC_BASE_URL=https://vikt.example.com

# The former name for the same thing, still read as a fallback so an upgrade
# does not lose its links. Remove it once PUBLIC_BASE_URL is set.
PUBLIC_ORIGIN=

# ------------------------------------------------------- deployment modes
# What this installation is. Each is off by default, and none of them can be
# changed from the admin UI: a toggle in a web interface that turns on outbound
# mail or exposes a public endpoint is an attack surface, and a self-hoster
# edits this file once. The API logs which modes are active at startup.
#
# LANDING_ENABLED serves the public landing page at /. Off means / redirects to
# /app and the landing bundle is never served. Leave it off for a private
# install.
LANDING_ENABLED=false

# REQUEST_ENABLED serves the request form at /kod and registers the endpoint it
# posts to. Off means both are 404: the path does not exist and neither does
# the route. Nothing links to /kod even when it is on, so turning it on means
# handing the address to somebody rather than publishing it (D127).
#
# It is deliberately not part of LANDING_ENABLED. A landing page is something
# to read; a request form creates work and responsibility. Every code you
# approve makes you responsible for another person's weight, meals and address,
# under your own name on /integritet, so this is a decision worth making one
# person at a time.
#
# CONTACT_EMAIL is required in production when either of these is on.
REQUEST_ENABLED=false

# LLM_ENABLED turns on every phase 8 surface: free-text food parsing, recipe
# suggestions, the pantry, saved recipes, the model-backed estimate and the
# photograph. Off means they are absent, not greyed out. Needs OLLAMA_URL as
# well; a flag with no host to talk to is an app advertising features that
# cannot work. The photograph needs LLM_VISION_MODEL on top of both.
LLM_ENABLED=false

# ----------------------------------------------------------------- web push
# VAPID is what lets this server identify itself to a browser's push service
# (D136). Generate a pair with `pnpm --filter api vapid`.
#
# **All three empty means push does not exist**: nothing is scheduled, the
# subscribe endpoint is not registered, and the reminders section in
# Inställningar is not drawn. That is a supported configuration and the default.
#
# Half-configured is refused at boot, and that refusal is the point. A public
# key with no private key produces subscriptions the server can never send to:
# the browser says yes, the row is stored, the person waits for a reminder that
# has no way to arrive, and nothing anywhere reports an error.
#
# The private key is a secret. The public one is handed to every browser that
# subscribes, which is its whole job. Changing the pair leaves every existing
# subscription answering 403; the API notices at the next boot and says so.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The mailto: or URL a push service contacts if this server misbehaves. The RFC
# requires one, and some services refuse a subscription without it.
VAPID_SUBJECT=

# --------------------------------------------------------------- the rest
# Browser origins allowed to call the API directly, comma separated. Empty is
# right for the normal shape, where nginx proxies /api/ and everything is
# same-origin.
CORS_ORIGINS=

# Whether the API drains the outbound mail queue itself (D104). On by default,
# because the alternative was a separate process nobody ran and a queue that sat
# still while every visible signal said mail worked. Turn it off only to run
# `pnpm --filter api mail:worker` instead: two drainers on one queue is how a
# password reset arrives twice.
MAIL_WORKER_IN_PROCESS=true
